{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!.next", "!dist", "!build"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "noDefaultExport": "off"
      },
      "suspicious": {
        "noConsole": "warn",
        "noUnknownAtRules": "off"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "worker/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/lib/db/prisma-client",
                      "**/prisma-client",
                      "@/generated/prisma/client",
                      "@prisma/client",
                      "@prisma/client/**",
                      "@prisma/adapter-pg"
                    ],
                    "message": "Invariant 3: database access goes through src/lib/db/queries.ts; import from there instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "error"
          }
        }
      }
    },
    {
      "includes": ["src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/lib/db/prisma-client",
                      "**/prisma-client",
                      "@/generated/prisma/client",
                      "@prisma/client",
                      "@prisma/client/**",
                      "@prisma/adapter-pg"
                    ],
                    "message": "Invariant 3: database access goes through src/lib/db/queries.ts; import from there instead."
                  },
                  {
                    "group": ["next", "next/**", "next-auth", "next-auth/**"],
                    "message": "Invariant 1: src/lib/ is framework-free TypeScript; keep Next.js imports in src/app or src/components."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lib/db/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["next", "next/**", "next-auth", "next-auth/**"],
                    "message": "Invariant 1: src/lib/ is framework-free TypeScript; keep Next.js imports in src/app or src/components."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lib/env.ts"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    }
  ]
}
